<Project Sdk="Microsoft.NET.Sdk">

  <!-- A feature package, in the four-folder layout of FEATURE-COST-POLICY.md section 4: `common/`
       compiles into every target framework and each platform folder into the one framework that can
       use it, so a single `dotnet pack` writes one `lib/` folder and one dependency group per
       platform. Nothing in this assembly runs unless an application calls AddAppBadges(). -->
  <PropertyGroup>
    <!-- Every platform the feature supports, unconditionally: `dotnet pack` is what makes the package
         and it needs all three in one build, so a build of this project on its own needs the macOS
         workload, and so does a build of the solution that lists it. Narrow one inner build for local
         work with `-p:TargetFramework=net10.0-windows`; the plural `-p:TargetFrameworks=...` does not
         work as a switch, because it reaches the restore graph and not the referenced projects'
         builds. An application that references this project still builds only the inner build its own
         framework can use. -->
    <TargetFrameworks>net10.0-windows;net10.0-macos;net10.0</TargetFrameworks>
    <RootNamespace>XPlatUI.Badges</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The feature is AOT compatible for the same reason the library is: an application that opts
         in publishes the same way whether it did or not. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>App badging for XPlatUI: an unread count or a dot on the taskbar button or dock icon, with the per-platform implementation and opt-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

  <!-- The state and presenter seam are internal on purpose: an application is never handed a badge
       state and never implements a presenter, and the library ships no public API for either. The
       tests drive them directly, because the precedence between Count, Text and IsDot, and the
       degradation a platform without a text badge performs, are real behaviour that regresses
       silently if nothing watches it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="XPlatUI.Feature.Badges.Tests" />
  </ItemGroup>

  <!-- The four-folder layout: `common/` is compiled into every target framework by the default glob,
       and each platform folder only into the one framework that can use it. A file added to
       `common/` needs no build change, which is the point of doing it by folder. -->
  <ItemGroup>
    <Compile Remove="windows\**;linux\**;macos\**" />
  </ItemGroup>

  <!-- Exactly one of these is in any given build, and it is the one whose platform can use it. A
       platform-only dependency is what makes the package safe to publish as a single artifact: the
       dependency groups of section 4 are selected by target framework, so a Windows application never
       restores the Linux backend. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="windows\**\*.cs" />
    <ProjectReference Include="..\XPlatUI.Backend.Win32\XPlatUI.Backend.Win32.csproj" />
  </ItemGroup>

  <!-- The Windows half declares the taskbar COM interface with a source-generated marshaller and
       builds the overlay icon through GDI, which needs unsafe code; nothing on the other two
       platforms does. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <Compile Include="macos\**\*.cs" />
    <ProjectReference Include="..\XPlatUI.Backend.AppKit\XPlatUI.Backend.AppKit.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="linux\**\*.cs" />
    <ProjectReference Include="..\XPlatUI.Backend.Gtk4\XPlatUI.Backend.Gtk4.csproj" />
  </ItemGroup>

</Project>
