<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests for the Win32 backend's internal seams. The project targets
       net10.0-windows because the backend does, and it is deliberately separate from the portable
       Kolvir.Tests: everything there runs on all three platforms, and this one cannot. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kolvir.Backend.Win32.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kolvir.Backend.Win32\Kolvir.Backend.Win32.csproj" />
  </ItemGroup>

</Project>
