<Project Sdk="Microsoft.NET.Sdk">

  <!-- A feature package, in the four-folder layout of FEATURE-COST-POLICY.md section 4: `common/`
       compiles into every target framework and each platform folder into the one framework that can
       use it, so a single `dotnet pack` writes one `lib/` folder and one dependency group per
       platform. Nothing in this assembly runs unless an application calls AddDragDrop(). -->
  <PropertyGroup>
    <!-- The frameworks a package ships for: every platform, which is what `dotnet pack` needs and what
         the pack job asks for by name. Everything else gets the platform it is running on plus the
         portable framework, from KolvirTargetFrameworks in Directory.Build.props, so a build only
         needs the workload of the platform it is on. -->
    <TargetFrameworks>$(KolvirTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Kolvir</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The feature is AOT compatible for the same reason the library is: an application that opts
         in publishes the same way whether it did or not. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Drag and drop for Kolvir: AllowDrop, the four drag handlers, and the per-platform hook and opt-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Kolvir\Kolvir.csproj" />
  </ItemGroup>

  <!-- The routing the feature does is internal on purpose: an application never names
       DragDropRouter or DragDropState, and the library ships no public API for them, which
       is what keeps the feature out of an application that never opts in. The tests drive those two
       types directly, because the behaviour they carry is real behaviour - which control a drag
       reaches, when it is told the drag arrived or left, what effect the target settles on - and it
       regresses silently if nothing watches it. This grants visibility to the feature's own test
       assembly and nothing else; no new public API was added for testing, and Kolvir.Tests and the
       core library are untouched. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kolvir.Feature.DragDrop.Tests" />
    <!-- The demo's "Drag/drop lifetime" page reads the reference-count diagnostic that
         windows/Win32DropReferenceTrace.cs publishes. That type is internal on purpose: the count of
         a borrowed data object is a diagnostic, not something an application should build on, so the
         grant is to the one assembly that has to display it rather than a public surface. The name
         has to be the demo's assembly identity, which its csproj overrides to KolvirDemoApp; the
         namespace Kolvir.Demo.App would grant nothing. -->
    <InternalsVisibleTo Include="KolvirDemoApp" />
  </ItemGroup>

  <!-- The four-folder layout: `common/` is compiled into every target framework by the default glob,
       and each platform folder only into the one framework that can use it. A file added to
       `common/` needs no build change, which is the point of doing it by folder. -->
  <ItemGroup>
    <Compile Remove="windows\**;linux\**;macos\**" />
  </ItemGroup>

  <!-- Exactly one of these is in any given build, and it is the one whose platform can use it. A
       platform-only dependency is what makes the package safe to publish as a single artifact: the
       dependency groups of section 4 are selected by target framework, so a Windows application never
       restores the Linux backend. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="windows\**\*.cs" />
    <ProjectReference Include="..\..\backends\Kolvir.Backend.Win32\Kolvir.Backend.Win32.csproj" />
  </ItemGroup>

  <!-- The Windows half hands the shell a COM object and builds its vtable by hand, which needs
       unsafe code; nothing on the other two platforms does. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <Compile Include="macos\**\*.cs" />
    <ProjectReference Include="..\..\backends\Kolvir.Backend.AppKit\Kolvir.Backend.AppKit.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="linux\**\*.cs" />
    <ProjectReference Include="..\..\backends\Kolvir.Backend.Gtk4\Kolvir.Backend.Gtk4.csproj" />
  </ItemGroup>

</Project>
