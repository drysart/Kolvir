<Project Sdk="Microsoft.NET.Sdk">

  <!-- A feature package, in the four-folder layout of FEATURE-COST-POLICY.md section 4, and rung 3
       because a virtual DOM is a way of building an application rather than a control: an
       application that does not adopt it should not carry it. Everything here is portable object
       graph work, so `common/` holds all of it and the platform folders stay empty - they exist
       because the `lib/` folders and dependency groups come from these same inner builds. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0-macos;net10.0</TargetFrameworks>
    <RootNamespace>Kolvir</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AOT compatible for the same reason the library is: an application that opts in publishes the
         same way whether it did or not. Reconciling a tree is comparison and assignment over objects
         that were created by generated code, so there is nothing here for the trimmer to give up on
         and nothing that needs an interpreter. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Virtual DOM for Kolvir: view model components whose Render() returns a tree of nodes that a reconciler diffs into the real control tree.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Kolvir\Kolvir.csproj" />
  </ItemGroup>

  <!-- The build-time half. It is referenced as an analyzer so that the projects in this repository
       get the generator and the diagnostics from the build, and it is packed into this package under
       `analyzers/dotnet/cs`, which is the folder NuGet and the compiler look in - how
       System.Text.Json's generator travels. A `ProjectReference` alone would reach this repository and
       nobody else. -->
  <ItemGroup>
    <ProjectReference Include="..\..\generators\Kolvir.Feature.VirtualDom.Generators\Kolvir.Feature.VirtualDom.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Packed from the generator's own output rather than from the resolved analyzer item: a
       `ProjectReference` does not hand its output path to the referencing project, and MSBuild has no
       target in the pack graph that exposes it. The path is stable because the generator's target
       framework is fixed at netstandard2.0, and a missing file fails the pack rather than shipping a
       package with no generator in it. Added once rather than per target framework: pack runs once, and
       the analyzer is one assembly whichever framework a consumer ends up binding. -->
  <ItemGroup>
    <None Include="..\..\generators\Kolvir.Feature.VirtualDom.Generators\bin\$(Configuration)\netstandard2.0\Kolvir.Feature.VirtualDom.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- The four-folder layout: `common/` is compiled into every target framework by the default glob,
       and each platform folder only into the one framework that can use it. -->
  <ItemGroup>
    <Compile Remove="windows\**;linux\**;macos\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <Compile Include="macos\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="linux\**\*.cs" />
  </ItemGroup>

</Project>
