<Project Sdk="Microsoft.NET.Sdk">

  <!-- A feature package, in the four-folder layout of FEATURE-COST-POLICY.md section 4, and rung 3
       because a virtual DOM is a way of building an application rather than a control: an
       application that does not adopt it should not carry it. Everything here is portable object
       graph work, so `common/` holds all of it and the platform folders stay empty - they exist
       because the `lib/` folders and dependency groups come from these same inner builds. -->
  <PropertyGroup>
    <!-- The frameworks a package ships for: every platform, which is what `dotnet pack` needs and what
         the pack job asks for by name. Everything else gets the platform it is running on plus the
         portable framework, from KolvirTargetFrameworks in Directory.Build.props, so a build only
         needs the workload of the platform it is on. -->
    <TargetFrameworks>$(KolvirTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Kolvir.Feature.VirtualDom</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AOT compatible for the same reason the library is: an application that opts in publishes the
         same way whether it did or not. Reconciling a tree is comparison and assignment over objects
         that were created by generated code, so there is nothing here for the trimmer to give up on
         and nothing that needs an interpreter. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Virtual DOM for Kolvir: view model components whose Render() returns a tree of nodes that a reconciler diffs into the real control tree.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Kolvir\Kolvir.csproj" />
    <!-- The seam in section 9 of dev-docs/OBSERVABLES.md: a component that renders from observable
         model state needs the collectors. The reference runs one way only - observables knows nothing
         about components, and must not, because it is usable without a UI at all. -->
    <ProjectReference Include="..\Kolvir.Feature.Observables\Kolvir.Feature.Observables.csproj" />
  </ItemGroup>

  <!-- The build-time half. It is packed into this package under `analyzers/dotnet/cs`, which is the
       folder NuGet and the compiler look in - how System.Text.Json's generator travels. A
       `ProjectReference` alone would reach this repository and nobody else.

       It is deliberately **not** a project reference. This project does not use the analyzer to
       compile - it has no manifest of its own - so all it needs is the dll at pack time. A project
       reference would put a netstandard2.0 project in the graph of everything that references this
       one, and `dotnet publish -p:PublishAot=true` passes PublishAot as a *global* property, which a
       netstandard2.0 project cannot satisfy: the publish stops with NETSDK1207 on the generator
       itself, in an application that never asked for a generator. A consumer of the package is
       unaffected either way, because a package ships the dll.

       Built with a separate `dotnet build` process rather than the `MSBuild` task, because the task
       inherits this build's global properties - a nested build under `dotnet pack` came out with no
       reference assemblies at all - and there is no reliable way to un-inherit all of them. A new
       process starts from the environment, which is exactly what a generator project needs, and `dotnet
       build` restores first, so a fresh checkout works.

       The project, the platform and configuration that build is pinned to and the dll it writes are
       all constants in Directory.Build.props, so this target and `$(VirtualDomGeneratorDll)` below
       cannot describe different directories. Nothing here reads `$(Configuration)` either: a property
       is expanded where it is assigned, and this project file is evaluated before the SDK defaults it. -->
  <Target Name="BuildVirtualDomGenerator" BeforeTargets="GenerateNuspec">
    <Exec Command="$(VirtualDomGeneratorBuildCommand)" />
  </Target>

  <!-- Packed from the generator's own output: a project reference does not hand its output path to the
       referencing project, and there is no target in the pack graph that exposes one. The path is
       derived in Directory.Build.props from the same configuration and platform the child build above
       is given, and it is stable because the generator's target framework is fixed at netstandard2.0;
       a missing file fails the pack rather than shipping a package with no generator in it. Added once
       rather than per target framework: pack runs once, and the analyzer is one assembly whichever
       framework a consumer ends up binding. -->
  <ItemGroup>
    <None Include="$(VirtualDomGeneratorDll)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- The generator reads the reference documentation from additional files, and asks the build for
         them: without this the node properties carry no documentation in any real application, which
         is measured and recorded in dev-docs/VNODE-DOCUMENTATION.md. -->
    <None Include="buildTransitive\Kolvir.Feature.VirtualDom.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- The four-folder layout: `common/` is compiled into every target framework by the default glob,
       and each platform folder only into the one framework that can use it. -->
  <ItemGroup>
    <Compile Remove="windows\**;linux\**;macos\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <Compile Include="macos\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="linux\**\*.cs" />
  </ItemGroup>

</Project>
