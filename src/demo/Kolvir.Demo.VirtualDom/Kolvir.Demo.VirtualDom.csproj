<Project Sdk="Microsoft.NET.Sdk">

  <!-- An application-scope sample for the virtual DOM's application level. The existing
       Kolvir.Demo.App is one window's page tree and cannot host this without being restructured, so
       this is a second, deliberately small application: a list window and one keyed window per
       document, rendered from an observable model. -->
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-macos</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RootNamespace>Kolvir.Demo.VirtualDom</RootNamespace>
    <AssemblyName>Kolvir.Demo.VirtualDom</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The whole point of the feature is to stay trim- and AOT-clean, so the sample that uses it
         does too. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The macOS 27 bindings refuse to build for anything older than macOS 14. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-macos'">14.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- No console for a GUI executable; diagnostics are borrowed from the parent console instead
         (ApplicationOptions.AttachConsole). Declaring DPI awareness in the manifest is what makes
         the raw Win32 window crisp. -->
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <!-- The macOS workload refuses to build unless Xcode's major.minor is exactly the version its
         bindings were generated against, so simply having a newer Xcode fails a sample that works.
         No CI job builds this target, so the check is skipped here like the other demos. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Kolvir\Kolvir.csproj" />
    <!-- The backend selector, not a backend: it resolves this project's TFM to exactly one backend
         and creates it. -->
    <ProjectReference Include="..\..\core\Kolvir.Backend\Kolvir.Backend.csproj" />
    <!-- The headless backend is the check mode's display: it owns the same real UiHost a native
         backend does, so the check drives real controls and real frames. -->
    <ProjectReference Include="..\..\backends\Kolvir.Backend.Headless\Kolvir.Backend.Headless.csproj" />
    <ProjectReference Include="..\..\features\Kolvir.Feature.VirtualDom\Kolvir.Feature.VirtualDom.csproj" />
    <!-- Used directly for the sample's observable model, as the existing demo does. -->
    <ProjectReference Include="..\..\features\Kolvir.Feature.Observables\Kolvir.Feature.Observables.csproj" />
  </ItemGroup>

  <!-- A project reference to the generator inherits global publish properties, and a netstandard2.0
       project cannot satisfy PublishAot. Building it in a child dotnet process is the same arrangement
       the existing demo uses, and the project, the pinned platform and the dll that results all come
       from Directory.Build.props so this target and `$(VirtualDomGeneratorDll)` cannot drift apart. -->
  <Target Name="BuildVirtualDomGenerator" BeforeTargets="CoreCompile">
    <Exec Command="$(VirtualDomGeneratorBuildCommand)" />
  </Target>

  <ItemGroup>
    <Analyzer Include="$(VirtualDomGeneratorDll)" />
  </ItemGroup>

</Project>
