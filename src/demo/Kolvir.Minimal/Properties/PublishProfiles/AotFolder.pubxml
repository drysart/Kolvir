<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes the measurement fixture from the IDE, which otherwise has no way to ask for an AOT
     publish: the fixture's settings live in its project file rather than in a profile, so that every
     platform is measured with the same properties, and this profile adds only what a publish started
     from the IDE has to decide for itself - the target framework, the runtime identifier, and where
     the output goes. Nothing here repeats the project file, so the measurement cannot drift from it.

     The runtime identifier is the interesting part. A build with no RID resolves no RID-specific
     native assets, so the Skia native library cannot be embedded in the executable
     (Kolvir/buildTransitive/Kolvir.targets), and publishing this project from Visual Studio used to
     fail there: the IDE builds the project before it publishes it, and that build has no RID. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- One framework per host, exactly as the project file chooses: net10.0-macos needs the macOS
         workload and Xcode, which only exist on a Mac. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-macos</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>

    <!-- NativeAOT only ever publishes for the host, so the host's own runtime is the useful default.
         Set $(RuntimeIdentifier) before this profile imports - on the command line or in a copy of
         this file - to publish for one the host itself is not. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('osx'))">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>

    <!-- NativeAOT has no shared framework to load from, so the publish is always self-contained. -->
    <SelfContained>true</SelfContained>

    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>
</Project>
