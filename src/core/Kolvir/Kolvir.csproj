<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The Kolvir control layer: window, controls, menus, dialogs and the platform backend contract, rendered with SkiaSharp.</Description>
    <RootNamespace>Kolvir</RootNamespace>
    <!-- The library must stay trim/AOT friendly: no reflection, no serializers, no dynamic. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <!-- The application model's container. Referenced here so IServiceCollection and every
         ecosystem package's Add* extension arrive transitively; apps add nothing (D11). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- Build assets. A NuGet consumer imports these automatically; this repository's own projects get
       them from Directory.Build.targets, because a ProjectReference imports no build assets. -->
  <ItemGroup>
    <None Include="buildTransitive\Kolvir.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Kolvir.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <!-- The union analyzer. It is not a lib/ asset and the library does not reference it: it is
       packed under analyzers/dotnet/cs, the folder NuGet and the compiler look in, so a package
       consumer gets KOLVIR0001-0004 with no opt-in. Directory.Build.targets adds the
       matching ProjectReference for this repository's own builds (including this project, which
       keeps it), so dotnet pack builds the DLL before GenerateNuspec. -->
  <PropertyGroup>
    <KolvirUnionAnalyzerDll>$(MSBuildThisFileDirectory)..\..\generators\Kolvir.Analyzers\bin\$(Configuration)\netstandard2.0\Kolvir.Analyzers.dll</KolvirUnionAnalyzerDll>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(KolvirUnionAnalyzerDll)"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- A package without the analyzer installs, compiles and silently loses every union
       diagnostic. The pack fails here instead, the same way the platform guard in
       Directory.Build.targets refuses a package that is missing a platform. -->
  <Target Name="KolvirRequireUnionAnalyzerToPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(KolvirUnionAnalyzerDll)')"
           Text="The union analyzer was not built at '$(KolvirUnionAnalyzerDll)', so the package would ship without KOLVIR0001-0004. Do not pack with --no-build; build the analyzer through the central reference in Directory.Build.targets." />
  </Target>

</Project>
