<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The AppKit backend binds the macOS SDK, so it targets net10.0-macos and needs the macOS
         workload to build on any host. It is part of WinFormsApp3.slnx, so building the solution
         needs that workload: a machine without it fails here with NETSDK1147. See README.md,
         "On macOS (AppKit)". -->
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- The macOS 27 bindings refuse to build for anything older than macOS 14, and nothing here
         needs a newer API than that. -->
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI.Backend.AppKit</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

  <!-- The drag and drop feature package owns the opt-in, but the native half of that feature needs
       this backend's internals: a view's dragged-type registration is done by a hook that calls
       into the view. The feature is the only friend assembly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="XPlatUI.Feature.DragDrop" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkiaSharp itself only ships Win32 natives; macOS needs the separate native package. The
         library references it so a host application never has to remember to. -->
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0" />
  </ItemGroup>

</Project>
