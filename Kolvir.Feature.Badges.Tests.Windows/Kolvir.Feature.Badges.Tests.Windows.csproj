<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows half of the badge feature, tested where it can run: the icon is drawn with Skia
       and handed to the shell as a GDI icon, so everything interesting is pixel geometry and GDI
       interop that the portable suite cannot reach.

       Separate from Kolvir.Feature.Badges.Tests because that project is deliberately portable: it
       resolves the net10.0 (linux) inner build of the feature, which has no Win32 code in it.

       Like every project that references the feature, this one wants -p:TargetFramework=net10.0-windows
       on restore and on the test invocation. The feature lists all three frameworks so that `dotnet
       pack` can build them in one pass, and a restore that is not narrowed evaluates every one of
       them - which on a machine without the macOS workload fails as NETSDK1147 from
       Kolvir.Backend.AppKit before a line here is compiled. The test workflow does that; the
       Kolvir.Feature.Badges.csproj comment explains why the plural -p:TargetFrameworks= is not the
       switch to reach for. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kolvir.Badges.Tests.Windows</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kolvir\Kolvir.csproj" />
    <ProjectReference Include="..\Kolvir.Feature.Badges\Kolvir.Feature.Badges.csproj" />
  </ItemGroup>

</Project>
