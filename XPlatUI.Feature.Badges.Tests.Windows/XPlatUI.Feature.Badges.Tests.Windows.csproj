<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows half of the badge feature, tested where it can run: the icon is drawn with Skia
       and handed to the shell as a GDI icon, so everything interesting is pixel geometry and GDI
       interop that the portable suite cannot reach.

       Separate from XPlatUI.Feature.Badges.Tests because that project is deliberately portable: it
       resolves the net10.0 (linux) inner build of the feature, which has no Win32 code in it. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI.Badges.Tests.Windows</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
    <ProjectReference Include="..\XPlatUI.Feature.Badges\XPlatUI.Feature.Badges.csproj" />
  </ItemGroup>

</Project>
