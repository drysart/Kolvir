<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XPlatUI.Backend.Win32</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The source-generated COM marshallers behind the file dialogs emit pointer code. This is the
         only reason; the backend's own source stays pointer-free. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XPlatUI\XPlatUI.csproj" />
  </ItemGroup>

  <!-- The drag and drop feature package owns the opt-in and its hook, but the native half of that
       feature needs this backend's internals: the OLE drop target and the lease that revokes it.
       The feature is the only friend assembly, and it is why this backend has no
       drag-and-drop-named public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="XPlatUI.Feature.DragDrop" />
  </ItemGroup>

</Project>
