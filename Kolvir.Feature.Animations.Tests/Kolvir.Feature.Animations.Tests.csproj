<Project Sdk="Microsoft.NET.Sdk">

  <!-- The animations feature's own suite, in an assembly of its own because the feature is a
       package of its own: a rung-3 feature is not part of the core library, so its tests are not
       part of the core suite either.

       The feature splits by platform - `common/` plus one of windows, macos or linux compiled per
       target framework - but these tests only touch `common/`, so the project takes one portable
       target framework and the reference resolves the `net10.0` (linux) inner build of the feature
       on every machine. That keeps the assembly buildable everywhere, which matters: a test project
       targeting net10.0-macos would need the .NET for macOS SDK with a matching Xcode on whichever
       mac builds it, and a test project has no business imposing that. Every animation is arithmetic
       plus a clock, so the portable inner build is the whole feature and there is nothing one
       platform can prove that another cannot. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kolvir.Animations.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- One test builds an application, because a callback that throws has to be seen going through
       Application.HandleNativeBoundary rather than out of the frame. The headless backend is
       what the rest of the suite uses for that, and it needs SkiaSharp's native library on the two
       platforms whose main package does not carry one. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kolvir\Kolvir.csproj" />
    <ProjectReference Include="..\Kolvir.Feature.Animations\Kolvir.Feature.Animations.csproj" />
    <ProjectReference Include="..\Kolvir.Backend.Headless\Kolvir.Backend.Headless.csproj" />
  </ItemGroup>

</Project>
