<!-- Solution folders mirror the directories. Each folder is named by its path: the SDK rejects
     nested <Folder> elements by silently dropping the projects they hold, so "/src/core/" plus
     its "/src/" parent is the form `dotnet sln migrate` writes. -->
<Solution>
  <Folder Name="/src/" />
  <Folder Name="/src/backends/">
    <Project Path="src/backends/Kolvir.Backend.AppKit/Kolvir.Backend.AppKit.csproj" />
    <Project Path="src/backends/Kolvir.Backend.Gtk4/Kolvir.Backend.Gtk4.csproj" />
    <Project Path="src/backends/Kolvir.Backend.Headless/Kolvir.Backend.Headless.csproj" />
    <Project Path="src/backends/Kolvir.Backend.Win32/Kolvir.Backend.Win32.csproj" />
  </Folder>
  <Folder Name="/src/core/">
    <Project Path="src/core/Kolvir.Backend/Kolvir.Backend.csproj" />
    <Project Path="src/core/Kolvir/Kolvir.csproj" />
  </Folder>
  <Folder Name="/src/demo/">
    <Project Path="src/demo/Kolvir.Demo.App/Kolvir.Demo.App.csproj" />
    <Project Path="src/demo/Kolvir.Minimal/Kolvir.Minimal.csproj" />
  </Folder>
  <Folder Name="/src/features/">
    <Project Path="src/features/Kolvir.Feature.AnimatedGif/Kolvir.Feature.AnimatedGif.csproj" />
    <Project Path="src/features/Kolvir.Feature.AnimatedWebp/Kolvir.Feature.AnimatedWebp.csproj" />
    <Project Path="src/features/Kolvir.Feature.Animations/Kolvir.Feature.Animations.csproj" />
    <Project Path="src/features/Kolvir.Feature.Audio/Kolvir.Feature.Audio.csproj" />
    <Project Path="src/features/Kolvir.Feature.Badges/Kolvir.Feature.Badges.csproj" />
    <Project Path="src/features/Kolvir.Feature.DragDrop/Kolvir.Feature.DragDrop.csproj" />
    <Project Path="src/features/Kolvir.Feature.Svg/Kolvir.Feature.Svg.csproj" />
    <Project Path="src/features/Kolvir.Feature.VirtualDom/Kolvir.Feature.VirtualDom.csproj" />
    <Project Path="src/features/Kolvir.Feature.WoffFonts/Kolvir.Feature.WoffFonts.csproj" />
  </Folder>
  <Folder Name="/tests/" />
  <Folder Name="/tests/backends/">
    <Project Path="tests/backends/Kolvir.Backend.Win32.Tests/Kolvir.Backend.Win32.Tests.csproj" />
  </Folder>
  <Folder Name="/tests/core/">
    <Project Path="tests/core/Kolvir.Tests/Kolvir.Tests.csproj" />
  </Folder>
  <Folder Name="/tests/features/">
    <Project Path="tests/features/Kolvir.Feature.AnimatedGif.Tests/Kolvir.Feature.AnimatedGif.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.AnimatedWebp.Tests/Kolvir.Feature.AnimatedWebp.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.Animations.Tests/Kolvir.Feature.Animations.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.Audio.Tests/Kolvir.Feature.Audio.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.Badges.Tests.Windows/Kolvir.Feature.Badges.Tests.Windows.csproj" />
    <Project Path="tests/features/Kolvir.Feature.Badges.Tests/Kolvir.Feature.Badges.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.DragDrop.Tests/Kolvir.Feature.DragDrop.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.Svg.Tests/Kolvir.Feature.Svg.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.VirtualDom.Tests/Kolvir.Feature.VirtualDom.Tests.csproj" />
    <Project Path="tests/features/Kolvir.Feature.WoffFonts.Tests/Kolvir.Feature.WoffFonts.Tests.csproj" />
  </Folder>
</Solution>