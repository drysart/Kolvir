<Project>

  <!-- A NuGet consumer imports buildTransitive/*.targets from the package automatically. This
	   repository's projects reference Kolvir by project instead, and a ProjectReference imports no
	   build assets at all, so the same file is imported here once. Every target in it is conditioned
	   on publishing with AOT, which makes it inert for the library, the backends and the demo. -->

  <Import Project="$(MSBuildThisFileDirectory)src\core\Kolvir\buildTransitive\Kolvir.targets" />

  <!-- A package carries one lib/ folder and one dependency group per platform, and NuGet falls back to
       the nearest one, so a package built for the host alone installs, compiles and then ships another
       platform's assembly - silently. The pack job opens every package it produced and fails one with a
       missing folder; this is the same rule at the point of packing, so a developer who packs locally
       gets an error instead of a package that only works on their own machine. -->
  <Target Name="KolvirRequireEveryPlatformToPack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(ShipsToConsumers)' == 'true' and '$(TargetFrameworks)' != '' and '$(TargetFrameworks)' != '$(KolvirShipTargetFrameworks)'">
    <Error Text="$(MSBuildProjectName) is packing for '$(TargetFrameworks)', and a package needs every platform - NuGet falls back to the nearest lib/ folder, so a package missing one hands its consumers another platform's assembly without saying so. Pack with -p:KolvirTargetFrameworks=&quot;$(KolvirShipTargetFrameworks)&quot;, which is what the pack job passes." />
  </Target>

  <!-- The same arrangement for the SVG feature's own native library. Both files are inert unless an
	   application publishes with AOT, so importing them here changes nothing about the library, the
	   backends, the tests or a normal demo run. -->
  <Import Project="$(MSBuildThisFileDirectory)src\features\Kolvir.Feature.Svg\buildTransitive\Kolvir.Feature.Svg.targets" />

</Project>
