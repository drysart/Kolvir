<Project>

  <!-- Package metadata that every project shares. It lives here because it is identical across the
       projects and because the alternative is what the SDK falls back to: a package on a feed whose
       description reads "Package Description". Only packable projects are affected - the sample, the
       measurement fixture and the test projects are never packaged. -->
  <PropertyGroup>
    <Authors>drysart</Authors>
    <PackageProjectUrl>https://kolvir.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/drysart/Kolvir</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The XML documentation file, which is what IntelliSense reads when an application consumes the
       package. Without it `dotnet pack` writes the assembly and nothing beside it, so every
       `<summary>` in this repository is invisible to a consumer - the compiler only emits the file
       when it is asked to. The SDK packs it into lib/<tfm>/ next to the .dll by itself, so this one
       property is the whole of it.

       Only the projects that ship generate one. The sample, the measurement fixture and the test
       projects are not packaged, so documenting them would be work no consumer can see, and
       CS1591 - one per undocumented public member - would bury the ones that matter in noise from
       test classes.

       CS1591 is an error for the projects that ship, not a warning. The backlog that made it one is
       gone, and a warning is exactly the kind of thing that is read past: a public member added
       without a `<summary>` ships an assembly whose documentation silently omits it, and nothing
       fails. An error is the only version of this rule that survives a busy day. It is raised by
       the compiler instead of an analyzer, so it costs nothing at build time and nothing at run
       time. -->
  <PropertyGroup>
    <ShipsToConsumers>true</ShipsToConsumers>
    <ShipsToConsumers Condition="'$(MSBuildProjectName)' == 'Kolvir.Minimal'
                               or '$(MSBuildProjectName)' == 'Kolvir.Demo.App'
                               or '$(MSBuildProjectName)' == 'Kolvir.Demo.VirtualDom'
                               or '$(MSBuildProjectName)' == 'Kolvir.Docs'
                               or '$(MSBuildProjectName)' == 'Kolvir.Docs.Snippets'
                               or $(MSBuildProjectName.Contains('.Tests'))">false</ShipsToConsumers>
    <GenerateDocumentationFile>$(ShipsToConsumers)</GenerateDocumentationFile>
    <WarningsAsErrors Condition="'$(ShipsToConsumers)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- The frameworks a package ships for. Every multi-targeting project takes its TargetFrameworks
       from here instead of listing the three platforms itself, because the list has to agree across
       the whole reference graph: a feature that lists net10.0-macos references Kolvir.Backend.AppKit
       from that inner build, so restore evaluates it and stops with NETSDK1147 on any machine that
       has not installed the macOS workload.

       So the default is the platform this build is running on, plus the portable framework - the
       suites are portable net10.0 assemblies and a net10.0 project cannot bind a platform-only asset
       (NU1201), so the portable framework has to stay in the list. Linux has no platform framework of
       its own, so its list *is* net10.0.

       Packaging is the one thing that needs every platform, and only packaging asks for it:
       `-p:KolvirAllPlatforms=true`. A switch rather than the list itself, because MSBuild cannot take
       one on the command line - a `-p:` value is split on semicolons and commas, so a list there is
       MSB1006, and passing it escaped as `%3B` leaves the escapes in TargetFrameworks and fails the
       inner-build dispatch with NETSDK1046. Both were measured; the list stays inside this file,
       where nothing has to escape anything. -->
  <PropertyGroup>
    <!-- Every platform a package ships for: what the switch below selects, and what the pack guard in
         Directory.Build.targets checks for. It has to be defined before it is used - MSBuild reads a
         PropertyGroup top to bottom, so a property referenced above its assignment is empty. -->
    <KolvirShipTargetFrameworks>net10.0-windows;net10.0-macos;net10.0</KolvirShipTargetFrameworks>
    <KolvirPlatformFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</KolvirPlatformFramework>
    <KolvirPlatformFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-macos</KolvirPlatformFramework>
    <KolvirTargetFrameworks>net10.0</KolvirTargetFrameworks>
    <KolvirTargetFrameworks Condition="'$(KolvirAllPlatforms)' == 'true'">$(KolvirShipTargetFrameworks)</KolvirTargetFrameworks>
    <KolvirTargetFrameworks Condition="'$(KolvirAllPlatforms)' != 'true' and '$(KolvirPlatformFramework)' != ''">$(KolvirPlatformFramework);net10.0</KolvirTargetFrameworks>
  </PropertyGroup>

  <!-- The virtual DOM's generator, the platform and configuration the child `dotnet build` that
       produces it is pinned to, and the dll that results. Three projects shell out to that build - the
       feature, the second sample and the demo - because a project reference and the `MSBuild` task both
       inherit the calling build's global properties (each of their targets says why), so its output
       path is not something MSBuild can work out: it is whatever that separate process wrote. Both
       halves of the contract live here, once, so the path and the build cannot describe different
       directories.

       Every input to that path is a constant, and none is read from the build that happens to be
       running. That is the point, and it is a rule about this file rather than about the generator:
       MSBuild expands a property reference where the property is *assigned*, and this file is read
       before the SDK fills in its defaults. `-c $(Configuration)` here was therefore handed to the
       child as a bare `-c` by a plain `dotnet build` - which passes no configuration at all - and the
       SDK rejected it; and a `Configuration` set any later than this file would have moved the output
       to a directory the items below do not name, which is the same silent mismatch that appeared
       under a publish. Anything Configuration-dependent belongs in a target, where it expands when the
       target runs; this contract simply does not depend on it.

       `Platform` is pinned to AnyCPU because it arrives as a global property from a Visual Studio
       publish and as an environment variable inside a Developer Command Prompt (vcvars64.bat sets it
       to x64), and a separate process inherits both; with `Platform=x64` the SDK writes
       `bin\x64\<Configuration>\netstandard2.0`. `Configuration` is pinned to Release for the same kind
       of reason: the analyzer is the assembly the compiler loads, so one build of it serves every
       build of every application, and a Debug and a Release build of an application cannot disagree
       about which dll that is. It is a compiler plugin, and its own optimisation level is not a
       debugging aid for anything. -->
  <PropertyGroup>
    <VirtualDomGeneratorProject>$(MSBuildThisFileDirectory)src\generators\Kolvir.Feature.VirtualDom.Generators\Kolvir.Feature.VirtualDom.Generators.csproj</VirtualDomGeneratorProject>
    <VirtualDomGeneratorPlatform>AnyCPU</VirtualDomGeneratorPlatform>
    <VirtualDomGeneratorConfiguration>Release</VirtualDomGeneratorConfiguration>
    <VirtualDomGeneratorBuildCommand>dotnet build "$(VirtualDomGeneratorProject)" -c $(VirtualDomGeneratorConfiguration) -p:Platform=$(VirtualDomGeneratorPlatform) --nologo</VirtualDomGeneratorBuildCommand>
    <VirtualDomGeneratorDll>$(MSBuildThisFileDirectory)src\generators\Kolvir.Feature.VirtualDom.Generators\bin\$(VirtualDomGeneratorConfiguration)\netstandard2.0\Kolvir.Feature.VirtualDom.Generators.dll</VirtualDomGeneratorDll>
  </PropertyGroup>

  <!-- A NuGet consumer imports buildTransitive/Kolvir.props from the package automatically. This
	   repository's projects reference Kolvir by project instead, and a ProjectReference imports no
	   build assets at all, so the same file is imported here. Keeping the two routes identical is
	   what makes the demo app a valid stand-in for an application that installs the package. -->

  <Import Project="$(MSBuildThisFileDirectory)src\core\Kolvir\buildTransitive\Kolvir.props" />

</Project>
