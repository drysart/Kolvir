<Project>

  <!-- A NuGet consumer imports buildTransitive/Kolvir.props from the package automatically. This
	   repository's projects reference Kolvir by project instead, and a ProjectReference imports no
	   build assets at all, so the same file is imported here. Keeping the two routes identical is
	   what makes the demo app a valid stand-in for an application that installs the package. -->

  <Import Project="$(MSBuildThisFileDirectory)Kolvir\buildTransitive\Kolvir.props" />

</Project>
