<Project>

  <!-- Package metadata that every project shares. It lives here because it is identical across the
       projects and because the alternative is what the SDK falls back to: a package on a feed whose
       description reads "Package Description". Only packable projects are affected - the sample, the
       measurement fixture and the test projects are never packaged. -->
  <PropertyGroup>
    <Authors>drysart</Authors>
    <PackageProjectUrl>https://kolvir.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/drysart/Kolvir</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The XML documentation file, which is what IntelliSense reads when an application consumes the
       package. Without it `dotnet pack` writes the assembly and nothing beside it, so every
       `<summary>` in this repository is invisible to a consumer - the compiler only emits the file
       when it is asked to. The SDK packs it into lib/<tfm>/ next to the .dll by itself, so this one
       property is the whole of it.

       Only the projects that ship generate one. The sample, the measurement fixture and the test
       projects are not packaged, so documenting them would be work no consumer can see, and
       CS1591 - one per undocumented public member - would bury the ones that matter in noise from
       test classes.

       CS1591 is an error for the projects that ship, not a warning. The backlog that made it one is
       gone, and a warning is exactly the kind of thing that is read past: a public member added
       without a `<summary>` ships an assembly whose documentation silently omits it, and nothing
       fails. An error is the only version of this rule that survives a busy day. It is raised by
       the compiler instead of an analyzer, so it costs nothing at build time and nothing at run
       time. -->
  <PropertyGroup>
    <ShipsToConsumers>true</ShipsToConsumers>
    <ShipsToConsumers Condition="'$(MSBuildProjectName)' == 'Kolvir.Minimal'
                               or '$(MSBuildProjectName)' == 'Kolvir.Demo.App'
                               or $(MSBuildProjectName.Contains('.Tests'))">false</ShipsToConsumers>
    <GenerateDocumentationFile>$(ShipsToConsumers)</GenerateDocumentationFile>
    <WarningsAsErrors Condition="'$(ShipsToConsumers)' == 'true'">$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!-- The frameworks a package ships for. Every multi-targeting project takes its TargetFrameworks
       from here instead of listing the three platforms itself, because the list has to agree across
       the whole reference graph: a feature that lists net10.0-macos references Kolvir.Backend.AppKit
       from that inner build, so restore evaluates it and stops with NETSDK1147 on any machine that
       has not installed the macOS workload.

       So the default is the platform this build is running on, plus the portable framework - the
       suites are portable net10.0 assemblies and a net10.0 project cannot bind a platform-only asset
       (NU1201), so the portable framework has to stay in the list. Linux has no platform framework of
       its own, so its list *is* net10.0.

       Packaging is the one thing that needs every platform, and only packaging asks for it, by name:
       `-p:KolvirTargetFrameworks="net10.0-windows;net10.0-macos;net10.0"`. Anything set that way is
       used verbatim, so the same property is also how one platform is cross-built deliberately. -->
  <PropertyGroup>
    <KolvirPlatformFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</KolvirPlatformFramework>
    <KolvirPlatformFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-macos</KolvirPlatformFramework>
    <KolvirTargetFrameworks Condition="'$(KolvirTargetFrameworks)' == '' and '$(KolvirPlatformFramework)' == ''">net10.0</KolvirTargetFrameworks>
    <KolvirTargetFrameworks Condition="'$(KolvirTargetFrameworks)' == '' and '$(KolvirPlatformFramework)' != ''">$(KolvirPlatformFramework);net10.0</KolvirTargetFrameworks>
    <!-- The list a package must have, kept here so the projects' own comments and the pack guard in
         Directory.Build.targets name the same one. -->
    <KolvirShipTargetFrameworks>net10.0-windows;net10.0-macos;net10.0</KolvirShipTargetFrameworks>
  </PropertyGroup>

  <!-- A NuGet consumer imports buildTransitive/Kolvir.props from the package automatically. This
	   repository's projects reference Kolvir by project instead, and a ProjectReference imports no
	   build assets at all, so the same file is imported here. Keeping the two routes identical is
	   what makes the demo app a valid stand-in for an application that installs the package. -->

  <Import Project="$(MSBuildThisFileDirectory)src\core\Kolvir\buildTransitive\Kolvir.props" />

</Project>
