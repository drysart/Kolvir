<Project Sdk="Microsoft.NET.Sdk">

  <!-- A feature package, in the four-folder layout of FEATURE-COST-POLICY.md section 4: `common/`
       compiles into every target framework and each platform folder into the one framework that can
       use it, so a single `dotnet pack` writes one `lib/` folder and one dependency group per
       platform. Nothing in this assembly runs unless an application calls AddWoffFonts(). -->
  <PropertyGroup>
    <!-- Every platform the feature supports, unconditionally: `dotnet pack` is what makes the package
         and it needs all three in one build, so a build of this project on its own needs the macOS
         workload, and so does a build of the solution that lists it. Narrow one inner build for local
         work with `-p:TargetFramework=net10.0`; the plural `-p:TargetFrameworks=...` does not work as
         a switch, because it reaches the restore graph and not the referenced projects' builds. An
         application that references this project still builds only the inner build its own framework
         can use. -->
    <TargetFrameworks>net10.0-windows;net10.0-macos;net10.0</TargetFrameworks>
    <RootNamespace>Kolvir</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The feature is AOT compatible for the same reason the library is: an application that opts in
         publishes the same way whether it did or not. Decoding a font container is byte reading and
         arithmetic - zlib and Brotli both come from the BCL - so there is nothing here for the
         trimmer to give up on and nothing that needs an interpreter. -->
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Web font loading for Kolvir: a font format provider that unwraps WOFF and WOFF 2 into the OpenType bytes the library reads.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kolvir\Kolvir.csproj" />
  </ItemGroup>

  <!-- The decoders are internal: an application names AddWoffFonts() and the provider, never the
       unwrapper, and which of them runs is the loader's decision. The tests drive the decoders
       directly, because "the container was unwrapped, not guessed at" is a claim that needs a table
       comparison to prove. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kolvir.Feature.WoffFonts.Tests" />
  </ItemGroup>

  <!-- The four-folder layout: `common/` is compiled into every target framework by the default glob,
       and each platform folder only into the one framework that can use it. A file added to
       `common/` needs no build change, which is the point of doing it by folder. -->
  <ItemGroup>
    <Compile Remove="windows\**;linux\**;macos\**" />
  </ItemGroup>

  <!-- The three platform folders are empty, and that is the finding rather than an oversight: a WOFF
       file is zlib-compressed table data and a WOFF 2 file is Brotli plus reconstructed glyph
       records, so both are portable arithmetic over bytes. The folders stay because the layout is the
       package's shape - the `lib/` folders and dependency groups come from these same inner builds
       either way - and because a platform that shipped a font container of its own would belong
       here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <Compile Include="macos\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Include="linux\**\*.cs" />
  </ItemGroup>

</Project>
