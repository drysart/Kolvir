<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows half of the badge feature, tested where it can run: the icon is drawn with Skia
       and handed to the shell as a GDI icon, so everything interesting is pixel geometry and GDI
       interop that the portable suite cannot reach.

       Separate from Kolvir.Feature.Badges.Tests because that project is deliberately portable: it
       resolves the net10.0 (linux) inner build of the feature, which has no Win32 code in it.

       Like every project that references the feature, this one needs no framework switch: on
       Windows the feature builds its `net10.0-windows` inner build, which is the one a
       `net10.0-windows` project binds, and the restore never evaluates the macOS one whose workload
       this machine does not have (KolvirTargetFrameworks, in Directory.Build.props). -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kolvir.Badges.Tests.Windows</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Kolvir\Kolvir.csproj" />
    <ProjectReference Include="..\..\..\src\features\Kolvir.Feature.Badges\Kolvir.Feature.Badges.csproj" />
  </ItemGroup>

</Project>
