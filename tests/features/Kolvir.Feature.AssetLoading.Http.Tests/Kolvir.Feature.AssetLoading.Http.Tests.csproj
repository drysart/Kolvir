<Project Sdk="Microsoft.NET.Sdk">

  <!-- The HTTP asset loader's own suite, in an assembly of its own for the same reason the loader is
       a package of its own: a rung-3 feature's tests live with the feature.

       There is no network, no socket and no timer here. A fake HttpMessageHandler is the transport,
       which is why an application-supplied handler is part of the public options rather than a test
       hook: the suite uses the same seam an application uses. A response is completed by hand, so
       every assertion is about what the loader did rather than about how long the test waited. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kolvir.Feature.AssetLoading.Http.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableMSTestRunner>false</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The canned response is a real PNG, decoded by the application's ImageDataFactory, so the suite
       needs SkiaSharp's native library on the two platforms whose main package does not carry one. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('osx'))">
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Kolvir\Kolvir.csproj" />
    <ProjectReference Include="..\..\..\src\features\Kolvir.Feature.AssetLoading\Kolvir.Feature.AssetLoading.csproj" />
    <ProjectReference Include="..\..\..\src\features\Kolvir.Feature.AssetLoading.Http\Kolvir.Feature.AssetLoading.Http.csproj" />
  </ItemGroup>

</Project>
